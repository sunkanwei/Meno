* text=auto

*.md text eol=lf
*.sh text eol=lf
*.swift text eol=lf
*.m text eol=lf
*.h text eol=lf
*.rs text eol=lf
*.toml text eol=lf
*.json text eol=lf

# Bundled renderer output may contain significant whitespace inside generated strings.
/mac/Features/MarkdownPreviewRenderer/dist/** -whitespace

/windows/*.ps1 text eol=crlf
/windows/**/*.ps1 text eol=crlf
/windows/**/*.cmd text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.cur binary
*.ani binary
*.mp3 binary
*.zip binary
*.exe binary
*.dll binary
*.lib binary
*.pdb binary
