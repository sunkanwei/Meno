; Meno Virtual Mouse UMDF 2 HID minidriver package.
; Based on Microsoft's vhidmini2 sample under the Microsoft Public License.

[Version]
Signature="$WINDOWS NT$"
Class=HIDClass
ClassGuid={745a17a0-74d3-11d0-b6fe-00a0c90f57da}
Provider=%ProviderName%
DriverVer=08/11/2026,2.3.5.0
CatalogFile=MenoVirtualMouse.cat
PnpLockdown=1

[DestinationDirs]
DefaultDestDir=13

[SourceDisksNames]
1=%DiskName%,,,

[SourceDisksFiles]
MenoVirtualMouse.dll=1

[Manufacturer]
%ManufacturerName%=Meno,NTamd64.10.0...22000

[Meno.NTamd64.10.0...22000]
%DeviceDescription%=MenoVirtualMouse_Install,ROOT\MENOVIRTUALMOUSE

[MenoVirtualMouse_Install.NT]
CopyFiles=MenoVirtualMouse_Copy
Include=MsHidUmdf.inf
Needs=MsHidUmdf.NT
Include=WUDFRD.inf
Needs=WUDFRD_LowerFilter.NT

[MenoVirtualMouse_Install.NT.HW]
Include=MsHidUmdf.inf
Needs=MsHidUmdf.NT.hw
Include=WUDFRD.inf
Needs=WUDFRD_LowerFilter.NT.hw

[MenoVirtualMouse_Install.NT.Services]
Include=MsHidUmdf.inf
Needs=MsHidUmdf.NT.Services
Include=WUDFRD.inf
Needs=WUDFRD_LowerFilter.NT.Services

[MenoVirtualMouse_Install.NT.Filters]
Include=WUDFRD.inf
Needs=WUDFRD_LowerFilter.NT.Filters

[MenoVirtualMouse_Install.NT.Wdf]
UmdfService="MenoVirtualMouse",MenoVirtualMouse_Umdf
UmdfServiceOrder=MenoVirtualMouse
UmdfKernelModeClientPolicy=AllowKernelModeClients
UmdfFileObjectPolicy=AllowNullAndUnknownFileObjects
UmdfMethodNeitherAction=Copy
UmdfFsContextUsePolicy=CanUseFsContext2

[MenoVirtualMouse_Umdf]
UmdfLibraryVersion=$UMDFVERSION$
ServiceBinary="%13%\MenoVirtualMouse.dll"

[MenoVirtualMouse_Copy]
MenoVirtualMouse.dll

[Strings]
ProviderName="Meno"
ManufacturerName="Meno"
DiskName="Meno Virtual Mouse driver package"
DeviceDescription="Meno Virtual Mouse"
