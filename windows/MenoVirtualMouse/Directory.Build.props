<Project>
  <PropertyGroup>
    <MenoWdkPackagesDirectory Condition="'$(MenoWdkPackagesDirectory)' == ''">$(LOCALAPPDATA)\Meno\build-cache\wdk-nuget</MenoWdkPackagesDirectory>
  </PropertyGroup>
  <Import Project="$(MenoWdkPackagesDirectory)\Microsoft.Windows.WDK.x64.10.0.26100.6584\build\native\Microsoft.Windows.WDK.x64.props"
          Condition="Exists('$(MenoWdkPackagesDirectory)\Microsoft.Windows.WDK.x64.10.0.26100.6584\build\native\Microsoft.Windows.WDK.x64.props') and '$(Platform)' == 'x64'" />
  <Import Project="$(MenoWdkPackagesDirectory)\Microsoft.Windows.SDK.CPP.x64.10.0.26100.6584\build\native\Microsoft.Windows.SDK.cpp.x64.props"
          Condition="Exists('$(MenoWdkPackagesDirectory)\Microsoft.Windows.SDK.CPP.x64.10.0.26100.6584\build\native\Microsoft.Windows.SDK.cpp.x64.props') and '$(Platform)' == 'x64'" />
  <Import Project="$(MenoWdkPackagesDirectory)\Microsoft.Windows.SDK.CPP.10.0.26100.6584\build\native\Microsoft.Windows.SDK.cpp.props"
          Condition="Exists('$(MenoWdkPackagesDirectory)\Microsoft.Windows.SDK.CPP.10.0.26100.6584\build\native\Microsoft.Windows.SDK.cpp.props')" />
</Project>
